<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FoodieHub - Order History</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
    <header>
        <nav>
            <div class="logo">FoodieHub</div>
            <ul>
                <li><a href="/">Menu</a></li>
                <li><a href="/cart">Cart (<span id="cart-badge">0</span>)</a></li>
                <li><a href="/order-history">My Orders</a></li>
                <li class="admin-only"><a href="/admin/dashboard">Dashboard</a></li>
                <li class="admin-only"><a href="/admin-menu-manage">Manage Menu</a></li>
                <li><a href="/login">Login</a></li>
                <li><a href="/register">Register</a></li>
                <li id="nav-logout-item" style="display:none;"><a href="/logout">Logout</a></li>
            </ul>
        </nav>
    </header>
    <main>
        <h1>Order History</h1>
        <section id="order-history-list">
            <% if (orders.length===0) { %>
                <p>You have no past orders yet.</p>
                <% } else { %>
                    <% orders.forEach(function(order) { %>
                        <div class="order-card" data-order-id="<%= order._id %>">
                            <p class="order-date">
                                <%= new Date(order.createdAt).toLocaleString() %>
                            </p>
                            <p class="order-status">Status: <%= order.status %>
                            </p>
                            <ul class="order-items">
                                <% order.items.forEach(function(item) { %>
                                    <li>
                                        <%= item.quantity %> x
                                            <%= item.menuItem && item.menuItem.name ? item.menuItem.name : 'Item' %>
                                                <% if (item.customizations) { %>(<%= item.customizations %>)<% } %>
                                    </li>
                                    <% }); %>
                            </ul>
                            <p class="order-total">Total: $<%= order.total %>
                            </p>
                            <button class="reorder-btn" data-order-id="<%= order._id %>">Reorder</button>
                        </div>
                        <% }); %>
                            <% } %>
        </section>
    </main>
    <footer>
        <p>&copy; 2026 FoodieHub. All rights reserved.</p>
    </footer>
    <script src="/js/menu.js"></script>
    <script src="/js/cart.js"></script>
    <script src="/js/validation.js"></script>
    <script src="/js/admin.js"></script>
    <script src="/js/fetch.js"></script>
    <script src="/js/auth-status.js"></script>
</body>

</html>