<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FoodieHub - Order History</title>
    <link rel="stylesheet" href="/public/css/styles.css">
</head>
<body>
    <header>
        <nav>
            <div class="logo">FoodieHub</div>
            <ul>
                <li><a href="index.html">Menu</a></li>
                <li><a href="cart.html">Cart (<span id="cart-badge">0</span>)</a></li>
                <li><a href="order-history.html">My Orders</a></li>
                <li class="admin-only"><a href="admin-dashboard.html">Dashboard</a></li>
                <li class="admin-only"><a href="admin-menu-manage.html">Manage Menu</a></li>
                <li><a href="login.html">Login</a></li>
                <li><a href="register.html">Register</a></li>
            </ul>
        </nav>
    </header>
    <main>
        <h1>Order History</h1>
        <section id="order-history-list">
            <% if (orders.length === 0) { %>
                <p>You have no past orders yet.</p>
            <% } else { %>
                <% orders.forEach(function(order) { %>
                    <div class="order-card" data-order-id="<%= order._id %>">
                        <p class="order-date"><%= new Date(order.createdAt).toLocaleString() %></p>
                        <p class="order-status">Status: <%= order.status %></p>
                        <ul class="order-items">
                            <% order.items.forEach(function(item) { %>
                                <li>
                                    <%= item.quantity %> x
                                    <%= item.menuItem && item.menuItem.name ? item.menuItem.name : 'Item' %>
                                    <% if (item.customizations) { %>(<%= item.customizations %>)<% } %>
                                </li>
                            <% }); %>
                        </ul>
                        <p class="order-total">Total: $<%= order.total %></p>
                        <button class="reorder-btn" data-order-id="<%= order._id %>">Reorder</button>
                    </div>
                <% }); %>
            <% } %>
        </section>
    </main>
    <footer>
        <p>&copy; 2026 FoodieHub. All rights reserved.</p>
    </footer>
    <script src="/public/js/menu.js"></script>
    <script src="/public/js/cart.js"></script>
    <script src="/public/js/validation.js"></script>
    <script src="/public/js/admin.js"></script>
    <script src="/public/js/fetch.js"></script>
</body>
</html>
