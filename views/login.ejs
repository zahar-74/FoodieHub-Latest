<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FoodieHub — Login</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
    <header>
        <nav>
            <div class="logo">FoodieHub</div>
            <ul class="nav-links">
                <li><a href="/">Menu</a></li>
                <li><a href="/cart">Cart <span id="cart-badge">0</span></a></li>
                <li><a href="/order-history">My Orders</a></li>
                <li><a href="/login">Login</a></li>
                <li><a href="/admin">Admin</a></li>
                <li id="nav-logout-item" style="display:none;"><a href="/logout">Logout</a></li>
            </ul>
        </nav>
    </header>

    <main>
        <section>
            <h1>Login</h1>
            <% if (locals.error) { %>
                <div class="error-message"
                    style="color:#ef5a5a; background:#ffe8e8; padding:10px; border-radius:4px; margin-bottom:15px;">
                    <%= error %>
                </div>
                <% } %>
                    <form id="login-form" action="/login" method="POST" onsubmit="return validateLogin()">
                        <label for="login-email">Email:</label>
                        <input type="email" id="login-email" name="email" placeholder="you@example.com" required>
                        <span id="login-email-error" class="error-message"></span>

                        <label for="login-password">Password:</label>
                        <input type="password" id="login-password" name="password" placeholder="Enter password"
                            minlength="6" required>
                        <span id="login-password-error" class="error-message"></span>

                        <button type="submit">Login</button>
                    </form>
                    <p>Don't have an account? <a href="/register">Register here</a></p>
        </section>
    </main>

    <footer>
        <p>&copy; 2026 FoodieHub. Built with Hunger and Passion.</p>
    </footer>

    <script src="/js/menu.js"></script>
    <script src="/js/cart.js"></script>
    <script src="/js/validation.js"></script>
    <script src="/js/admin.js"></script>
    <script src="/js/fetch.js"></script>
    <script src="/js/auth-status.js"></script>
</body>

</html>