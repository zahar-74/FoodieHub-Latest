<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FoodieHub — Manage Menu</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
    <header>
        <nav>
            <div class="logo">FoodieHub Admin</div>
            <ul class="nav-links">
                <li><a href="/admin/dashboard">Dashboard</a></li>
                <li><a href="/admin/orders">Manage Orders</a></li>
                <li><a href="/admin-menu-manage">Manage Menu</a></li>
                <li><a href="/">View Site</a></li>
                <li id="nav-logout-item" style="display:none;"><a href="/logout">Logout</a></li>
            </ul>
        </nav>
    </header>

    <main>
        <h1>Manage Menu Items</h1>

        <section>
            <h2>Add New Item</h2>
            <form id="add-item-form">
                <label for="item-name">Name:</label>
                <input type="text" id="item-name" placeholder="e.g., Pepperoni Pizza" required>
                <span id="item-name-error" class="error-message"></span>

                <label for="item-description">Description:</label>
                <textarea id="item-description" placeholder="Describe the item" required></textarea>
                <span id="item-description-error" class="error-message"></span>

                <label for="item-price">Price ($):</label>
                <input type="number" id="item-price" step="0.01" placeholder="9.99" required>
                <span id="item-price-error" class="error-message"></span>

                <label for="item-stock">Stock:</label>
                <input type="number" id="item-stock" placeholder="50" required>
                <span id="item-stock-error" class="error-message"></span>

                <label for="item-category">Category:</label>
                <select id="item-category">
                    <option value="Pizza">Pizza</option>
                    <option value="Burgers">Burgers</option>
                    <option value="Salads">Salads</option>
                    <option value="Drinks">Drinks</option>
                    <option value="Desserts">Desserts</option>
                </select>

                <button type="submit">Add Item</button>
            </form>
        </section>

        <section>
            <h2>Current Menu</h2>
            <table id="admin-menu-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Available</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- admin.js populates this -->
                </tbody>
            </table>
        </section>
    </main>

    <footer>
        <p>&copy; 2026 FoodieHub Admin</p>
    </footer>

    <script src="/js/menu.js"></script>
    <script src="/js/cart.js"></script>
    <script src="/js/validation.js"></script>
    <script src="/js/admin.js"></script>
    <script src="/js/fetch.js"></script>
    <script src="/js/auth-status.js"></script>
</body>

</html>