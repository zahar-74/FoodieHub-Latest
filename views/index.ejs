<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FoodieHub — Menu</title>
    <link rel="stylesheet" href="/css/styles.css">
    <script src="/js/fetch.js"></script>
</head>

<body>
    <header>
        <nav>
            <div class="logo">FoodieHub</div>
            <ul class="nav-links">
                <li><a href="/">Menu</a></li>
                <li><a href="/cart">Cart <span id="cart-badge">0</span></a></li>
                <li><a href="/order-history">My Orders</a></li>
                <li id="nav-login-item"><a href="/login">Login</a></li>
                <li id="nav-register-item"><a href="/register">Register</a></li>
                <li id="nav-logout-item" style="display:none;"><a href="/logout">Logout</a></li>
                <li><a href="/admin/dashboard">Admin</a></li>
            </ul>
        </nav>
    </header>

    <main>
        <section class="hero">
            <h1>Dive In To The Menu that fulfills your cravings</h1>
        </section>

        <section class="filters">
            <div class="filter-group">
                <label for="category-filter">Category</label>
                <select id="category-filter">
                    <option value="all">All</option>
                    <option value="Burgers">Burgers</option>
                    <option value="Desserts">Desserts</option>
                    <option value="Drinks">Drinks</option>
                    <option value="Pasta">Pasta</option>
                    <option value="Pizza">Pizza</option>
                    <option value="Salads">Salads</option>
                </select>
            </div>

            <div class="filter-group price-group">
                <label for="price-filter">Max Price</label>
                <input type="range" id="price-filter" min="0" max="50" value="50">
                <span id="price-filter-value">$50</span>
            </div>

            <div class="filter-group">
                <label for="diet-filter">Dietary</label>
                <select id="diet-filter">
                    <option value="all">All</option>
                    <option value="vegetarian">Vegetarian</option>
                    <option value="vegan">Vegan</option>
                    <option value="gluten-free">Gluten-Free</option>
                </select>
            </div>
        </section>

        <section id="menu-grid">
            <!-- menu.js + fetch.js populate this -->
        </section>
    </main>

    <footer>
        <p>&copy; 2026 FoodieHub. Built with Hunger and Passion.</p>
    </footer>

    <script src="/js/menu.js"></script>
    <script src="/js/cart.js"></script>
    <script src="/js/validation.js"></script>
    <script src="/js/admin.js"></script>
    <script src="/js/fetch.js"></script>
    <script src="/js/auth-status.js"></script>
</body>

</html>