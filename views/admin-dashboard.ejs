<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FoodieHub — Admin Dashboard</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
    <header>
        <nav>
            <div class="logo">FoodieHub Admin</div>
            <ul class="nav-links">
                <li><a href="/admin/dashboard">Dashboard</a></li>
                <li><a href="/admin/orders">Manage Orders</a></li>
                <li><a href="/admin-menu-manage">Manage Menu</a></li>
                <li><a href="/">View Site</a></li>
                <li id="nav-logout-item" style="display:none;"><a href="/logout">Logout</a></li>
            </ul>
        </nav>
    </header>

    <main>
        <h1>Admin Dashboard</h1>
        <section id="stats">
            <div class="stat-card">
                <h3>Total Orders</h3>
                <span id="total-orders">
                    <%= stats.totalOrders %>
                </span>
            </div>
            <div class="stat-card">
                <h3>Revenue</h3>
                <span id="total-revenue">$<%= stats.revenue.toFixed(2) %></span>
            </div>
            <div class="stat-card">
                <h3>Pending Orders</h3>
                <span id="pending-orders">
                    <%= stats.pendingOrders %>
                </span>
            </div>
        </section>

        <section>
            <h2>Recent Orders</h2>
            <table id="admin-orders-table">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (recentOrders.length===0) { %>
                        <tr>
                            <td colspan="6">No recent orders.</td>
                        </tr>
                        <% } else { %>
                            <% recentOrders.forEach(order=> { %>
                                <tr>
                                    <td>
                                        <%= order._id %>
                                    </td>
                                    <td>
                                        <%= order.customerId ? order.customerId.name : 'Unknown customer' %>
                                    </td>
                                    <td>
                                        <%= order.items.reduce((sum, item)=> sum + (item.quantity || 0), 0) %>
                                    </td>
                                    <td>$<%= (order.total || 0).toFixed(2) %>
                                    </td>
                                    <td>
                                        <%= order.status %>
                                    </td>
                                    <td><a href="/admin/orders">View</a></td>
                                </tr>
                                <% }) %>
                                    <% } %>
                </tbody>
            </table>
        </section>
    </main>

    <footer>
        <p>&copy; 2026 FoodieHub Admin</p>
    </footer>

    <script src="/js/menu.js"></script>
    <script src="/js/cart.js"></script>
    <script src="/js/validation.js"></script>
    <script src="/js/admin.js"></script>
    <script src="/js/fetch.js"></script>
    <script src="/js/auth-status.js"></script>
</body>

</html>